<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WorkerManagement"
        tools:targetApi="31">

        <!-- ──── LAUNCHER ──── -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ──── WORKER ACTIVITIES ──── -->
        <activity
            android:name=".ui.worker.LoginWorkerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.worker.RegisterWorkerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".ui.worker.LoginWorkerActivity" />

        <activity
            android:name=".SearchActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".JobDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".SearchActivity" />

        <activity
            android:name=".WorkerProfileActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".SearchActivity" />

        <activity
            android:name=".MyApplicationsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".SearchActivity" />

        <!-- ──── MANAGER ACTIVITIES ──── -->
        <activity
            android:name=".ui.manager.LoginManagerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.manager.RegisterManagerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".ui.manager.LoginManagerActivity" />

        <activity
            android:name=".ManageActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".PostWorkActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".ManageActivity" />

        <activity
            android:name=".ApplicationsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".ManageActivity" />

    </application>

</manifest>